@using MudBlazor
@using System.Text.Json
@using System.Text.Json.Serialization
@using SupportTicketSystem.Bsui.Components.Models.Reports

<MudPaper Elevation="0"
          Outlined="true"
          Class="pa-4 rounded-lg d-flex flex-column"
          Style="@($"background-color: var(--mud-palette-surface); border-color: var(--mud-palette-lines-default); width: 100%; height: {CardHeight}px; box-sizing: border-box;")">

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween"
              Class="mb-2">

        <MudText Style="font-weight: 700; font-size: 16px; color: var(--mud-palette-text-primary);">
            @Title
        </MudText>

        <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                       Size="Size.Small"
                       Style="color: var(--mud-palette-text-secondary);" />
    </MudStack>

    <!-- Kontainer ECharts -->
    <div style="flex-grow: 1; min-height: 0;">
        <EChartWrapper ChartOptionJson="@_chartOptionJson" Height="@(CardHeight - 60)" />
    </div>

</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<AssigneeChartItem> Items { get; set; } = Array.Empty<AssigneeChartItem>();

    [Parameter]
    public int CardHeight { get; set; } = 300;

    [Parameter]
    public int AxisMaximum { get; set; } = 300;

    [Parameter]
    public int AxisStep { get; set; } = 50;

    // Tetap menggunakan warna biru sesuai gambar, jika ingin pakai warna tema bisa diganti var(--mud-palette-primary)
    [Parameter]
    public string BarColor { get; set; } = "#2F73F6";

    private string _chartOptionJson = "{}";

    // Mengambil Font Family bawaan Sopodel Theme
    private readonly string _fontFamily = "Inter, Roboto, Helvetica, Arial, sans-serif";

    protected override void OnParametersSet()
    {
        if (Items != null)
        {
            var optionObj = GetChartOptions();
            
            _chartOptionJson = JsonSerializer.Serialize(optionObj, new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
            });
        }
    }

    private object GetChartOptions()
    {
        return new
        {
            tooltip = new
            {
                trigger = "axis",
                axisPointer = new { type = "shadow" },
                textStyle = new { fontFamily = _fontFamily }
            },
            grid = new
            {
                left = "2%",
                right = "8%", // Memberi ruang ekstra di kanan untuk label nilai angka (misal: 245)
                bottom = "0%",
                top = "5%",
                containLabel = true
            },
            xAxis = new
            {
                type = "value",
                max = AxisMaximum,
                interval = AxisStep,
                axisLabel = new
                {
                    fontFamily = _fontFamily,
                    color = "var(--mud-palette-text-secondary)"
                },
                splitLine = new { show = false }, // Menghilangkan garis vertikal di background sesuai gambar
                axisLine = new { show = false },
                axisTick = new { show = false }
            },
            yAxis = new
            {
                type = "category",
                inverse = true, // Membalik urutan agar item pertama tampil paling atas
                data = Items.Select(x => x.AssigneeName).ToArray(),
                axisLabel = new
                {
                    fontFamily = _fontFamily,
                    color = "var(--mud-palette-text-primary)",
                    fontWeight = 500
                },
                axisLine = new { show = false },
                axisTick = new { show = false }
            },
            series = new[]
            {
                new
                {
                    name = "Total Tickets",
                    type = "bar",
                    barWidth = 16, // Lebar/ketebalan bar disamakan dengan desain aslinya
                    itemStyle = new
                    {
                        color = BarColor,
                        borderRadius = new[] { 0, 4, 4, 0 } // Melengkungkan sudut kanan bar agar terlihat modern
                    },
                    label = new
                    {
                        show = true,
                        position = "right", // Angka diletakkan di sebelah kanan bar
                        distance = 10,
                        color = "var(--mud-palette-text-primary)",
                        fontFamily = _fontFamily,
                        fontWeight = 700 // Angka ditebalkan
                    },
                    data = Items.Select(x => x.TotalTickets).ToArray()
                }
            }
        };
    }
}
