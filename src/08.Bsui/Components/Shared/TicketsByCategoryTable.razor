@using System.Globalization
@using SupportTicketSystem.Bsui.Components.Models.Reports

<MudPaper Elevation="0"
          Class="pa-4"
          Style="@CardStyle">

    <MudText Style="@TitleStyle"
             Class="mb-4">
        @Title
    </MudText>

    <div style="overflow-x:auto;">
        <table style="@TableStyle">

            <thead>
                <tr style="background-color:#f8fafc;">
                    <th style="@HeaderLeftStyle">
                        Category
                    </th>

                    <th style="@HeaderCenterStyle">
                        Total Tickets
                    </th>

                    <th style="@HeaderBarStyle"></th>

                    <th style="@HeaderRightStyle">
                        % of Total
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Items)
                {
                    var percentage = GetPercentage(item.TotalTickets);

                    <tr>
                        <td style="@BodyLeftStyle">
                            @item.CategoryName
                        </td>

                        <td style="@BodyCenterStyle">
                            @item.TotalTickets
                        </td>

                        <td style="@BarCellStyle">
                            <div style="@GetBarStyle(item.TotalTickets)"></div>
                        </td>

                        <td style="@BodyRightStyle">
                            @FormatPercentage(percentage)
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <td style="@FooterLeftStyle">
                        Total
                    </td>

                    <td style="@FooterCenterStyle">
                        @FormatNumber(EffectiveTotal)
                    </td>

                    <td style="@FooterCenterStyle"></td>

                    <td style="@FooterRightStyle">
                        100%
                    </td>
                </tr>
            </tfoot>

        </table>
    </div>
</MudPaper>

@code {
    [Parameter]
    public string Title { get; set; } = "Tickets by Category";

    [Parameter]
    public IReadOnlyList<CategoryReportItem> Items { get; set; }
    = Array.Empty<CategoryReportItem>();

    [Parameter]
    public int CardHeight { get; set; } = 280;

    [Parameter]
    public double TotalTickets { get; set; }

    [Parameter]
    public string BarColor { get; set; } = "#2F73F6";

    private double EffectiveTotal =>
        TotalTickets > 0
            ? TotalTickets
            : Items.Sum(item => item.TotalTickets);

    private string CardStyle =>
        $"width:100%;" +
        $"min-height:{CardHeight}px;" +
        "box-sizing:border-box;" +
        "border:1px solid #e2e8f0;" +
        "border-radius:10px;" +
        "background:#ffffff;" +
        "box-shadow:none;";

    private const string TitleStyle =
        "font-size:16px;" +
        "font-weight:700;" +
        "color:#172033;";

    private const string TableStyle =
        "width:100%;" +
        "border-collapse:collapse;" +
        "table-layout:fixed;";

    private const string HeaderLeftStyle =
        "width:28%;" +
        "padding:12px 8px;" +
        "text-align:left;" +
        "font-size:11px;" +
        "font-weight:600;" +
        "color:#64748b;" +
        "border-bottom:1px solid #e2e8f0;";

    private const string HeaderCenterStyle =
        "width:20%;" +
        "padding:12px 8px;" +
        "text-align:center;" +
        "font-size:11px;" +
        "font-weight:600;" +
        "color:#64748b;" +
        "border-bottom:1px solid #e2e8f0;";

    private const string HeaderBarStyle =
        "width:34%;" +
        "padding:12px 8px;" +
        "border-bottom:1px solid #e2e8f0;";

    private const string HeaderRightStyle =
        "width:18%;" +
        "padding:12px 8px;" +
        "text-align:right;" +
        "font-size:11px;" +
        "font-weight:600;" +
        "color:#64748b;" +
        "border-bottom:1px solid #e2e8f0;";

    private const string BodyLeftStyle =
        "padding:8px 8px;" +
        "font-size:12px;" +
        "font-weight:500;" +
        "color:#334155;" +
        "border-bottom:1px solid #f1f5f9;";

    private const string BodyCenterStyle =
        "padding:8px 8px;" +
        "text-align:center;" +
        "font-size:12px;" +
        "font-weight:600;" +
        "color:#334155;" +
        "border-bottom:1px solid #f1f5f9;";

    private const string BodyRightStyle =
        "padding:8px 8px;" +
        "text-align:right;" +
        "font-size:12px;" +
        "font-weight:600;" +
        "color:#334155;" +
        "border-bottom:1px solid #f1f5f9;";

    private const string BarCellStyle =
        "width:34%;" +
        "padding:8px 8px;" +
        "border-bottom:1px solid #f1f5f9;";

    private const string FooterLeftStyle =
        "padding:10px 8px;" +
        "font-size:12px;" +
        "font-weight:700;" +
        "color:#172033;" +
        "border-top:1px solid #e2e8f0;";

    private const string FooterCenterStyle =
        "padding:10px 8px;" +
        "text-align:center;" +
        "font-size:12px;" +
        "font-weight:700;" +
        "color:#172033;" +
        "border-top:1px solid #e2e8f0;";

    private const string FooterRightStyle =
        "padding:10px 8px;" +
        "text-align:right;" +
        "font-size:12px;" +
        "font-weight:700;" +
        "color:#172033;" +
        "border-top:1px solid #e2e8f0;";

    private double GetPercentage(double value)
    {
        if (EffectiveTotal <= 0)
        {
            return 0;
        }

        return Math.Clamp(
            value / EffectiveTotal * 100,
            0,
            100);
    }

    private string GetBarStyle(int totalTickets)
    {
        if (MaximumCategoryTickets <= 0)
        {
            return "width:0%;height:16px;";
        }

        var percentage = Math.Clamp(
            totalTickets * 100d / MaximumCategoryTickets,
            0,
            100);

        return FormattableString.Invariant(
            $"width:{percentage:0.##}%;height:16px;background-color:{BarColor};border-radius:1px;");
    }

    private static string FormatNumber(double value)
    {
        return value.ToString(
            "N0",
            CultureInfo.InvariantCulture);
    }

    private static string FormatPercentage(double value)
    {
        return value.ToString(
            "0.0",
            CultureInfo.InvariantCulture) + "%";
    }

    private int MaximumCategoryTickets =>
    Items.Count == 0
        ? 0
        : Items.Max(item => item.TotalTickets);
}