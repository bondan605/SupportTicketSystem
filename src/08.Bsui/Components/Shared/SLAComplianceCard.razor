@using MudBlazor
@using MudBlazor.Charts

<style>
    .sla-card {
        padding: 24px;
    }

    .sla-container {
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .sla-chart {
        width: 230px;
        height: 230px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
    }

        .sla-chart .mud-chart {
            width: 230px !important;
            height: 230px !important;
        }

        /* Hilangkan legend bawaan */
        .sla-chart .mud-chart-legend {
            display: none !important;
        }

    .sla-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .sla-value {
        font-size: 72px;
        font-weight: 700;
        line-height: 1;
        color: var(--mud-palette-text-primary);
    }

    .sla-title {
        font-size: 22px;
        font-weight: 500;
        color: var(--mud-palette-text-primary);
        margin-top: 8px;
    }

    .sla-trend {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
    }

    .sla-trend-value {
        color: #22C55E;
        font-size: 22px;
        font-weight: 700;
    }

    .sla-trend-text {
        color: var(--mud-palette-text-primary);
        font-size: 22px;
    }
</style>

<MudPaper Outlined="true" Class="rounded-lg sla-card">

    <MudText Typo="Typo.h5" Style="font-weight:700;" Class="mb-5">
        @Title
    </MudText>

    <div class="sla-container">

        <div class="sla-chart">

            <MudChart T="double"
                      ChartType="ChartType.Donut"
                      ChartSeries="@([ChartData])"
                      ChartLabels="@ChartLabels"
                      ChartOptions="@_chartOptions"
                      Width="230px"
                      Height="230px" />

        </div>

        <div class="sla-content">

            <div class="sla-value">
                @($"{Value:F1}%")
            </div>

            <div class="sla-title">
                @Subtitle
            </div>

            <div class="sla-trend">

                <MudIcon Icon="@TrendIcon"
                         Color="@TrendColor"
                         Size="Size.Medium" />

                <span class="sla-trend-value">
                    @TrendValue
                </span>

                <span class="sla-trend-text">
                    dari periode lalu
                </span>

            </div>

        </div>

    </div>

</MudPaper>

@code {

    [Parameter] public string Title { get; set; } = "SLA Compliance";

    [Parameter] public double Value { get; set; } = 92.5;

    [Parameter] public string Subtitle { get; set; } = "Kepatuhan SLA";

    [Parameter] public string TrendValue { get; set; } = "+4.2%";

    [Parameter] public Color TrendColor { get; set; } = Color.Success;

    [Parameter] public string TrendIcon { get; set; } = Icons.Material.Filled.ArrowUpward;

    private double[] ChartData => new[]
    {
        Value,
        100 - Value
    };

    // Kosong supaya tidak muncul tulisan legend
    private readonly string[] ChartLabels =
    {
        "",
        ""
    };

    private readonly DonutChartOptions _chartOptions = new()
    {
        ShowLegend = false,
        ChartPalette = new[]
        {
            "#22C55E",
            "#E5E7EB"
        }
    };
}