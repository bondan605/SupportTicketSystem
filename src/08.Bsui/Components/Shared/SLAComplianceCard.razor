@using MudBlazor
@using System.Text.Json
@using System.Text.Json.Serialization

<MudPaper Outlined="true"
          Class="pa-4 rounded-lg d-flex flex-column"
          Style="@($"background-color: var(--mud-palette-surface); border-color: var(--mud-palette-lines-default); width: 100%; height: {CardHeight}px; box-sizing: border-box;")">

    <MudText Style="font-weight: 700; width: 100%; color: var(--mud-palette-text-primary); font-size: 16px;">
        @Title
    </MudText>

    <div class="d-flex flex-row align-center justify-center flex-grow-1 gap-4 mt-2">

        <!-- Kontainer ECharts 100x100px -->
        <div style="width: 100px; height: 100px; flex-shrink: 0; position: relative;">
            <EChartWrapper ChartOptionJson="@_chartOptionJson" Height="100" />
        </div>

        <div class="d-flex flex-column justify-center">

            <MudText Style="font-size: 36px; font-weight: 700; line-height: 1; color: var(--mud-palette-text-primary);">
                @($"{Value:F1}%")
            </MudText>

            <MudText Style="font-size: 13px; font-weight: 500; color: var(--mud-palette-text-secondary); margin-top: 4px;">
                @Subtitle
            </MudText>

        </div>

    </div>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "SLA Compliance";
    [Parameter] public double Value { get; set; } = 92.5;
    [Parameter] public string Subtitle { get; set; } = "Kepatuhan SLA";
    [Parameter] public string TrendValue { get; set; } = "+4.2%";
    [Parameter] public Color TrendColor { get; set; } = Color.Success;
    [Parameter] public string TrendIcon { get; set; } = Icons.Material.Filled.ArrowUpward;

    // Parameter Penyelaras Tinggi Kartu
    [Parameter] public int CardHeight { get; set; } = 260;

    private string _chartOptionJson = "{}";

    protected override void OnParametersSet()
    {
        var optionObj = GetChartOptions();

        _chartOptionJson = JsonSerializer.Serialize(optionObj, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
        });
    }

    private object GetChartOptions()
    {
        return new
        {
            series = new[]
            {
                new
                {
                    type = "pie",
                    radius = new[] { "75%", "100%" }, // Membuat bentuk cincin (donut) yang tipis dan modern
                    center = new[] { "50%", "50%" },
                    silent = true, // Mematikan animasi hover dan tooltip karena ini hanya indikator visual
                    label = new { show = false },
                    labelLine = new { show = false },
                    data = new[]
                    {
                        // Bagian nilai (Value) yang terisi dengan warna Emerald Green Sopodel
                        new
                        {
                            value = Value,
                            itemStyle = new { color = "#059669" }
                        },
                        // Bagian sisa (Background track) dengan warna abu-abu
                        new
                        {
                            value = 100 - Value,
                            itemStyle = new { color = "#E5E7EB" }
                        }
                    }
                }
            }
        };
    }
}