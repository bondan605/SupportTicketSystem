@using MudBlazor
@using System.Text.Json
@using System.Text.Json.Serialization

<MudPaper Outlined="true"
          Class="pa-4 rounded-lg d-flex flex-column"
          Style="@($"background-color: var(--mud-palette-surface); border-color: var(--mud-palette-lines-default); width: 100%; height: {CardHeight}px; box-sizing: border-box;")">

    <MudText Style="font-weight: 700; font-size: 16px; color: var(--mud-palette-text-primary); margin-bottom: 4px;">
        @Title
    </MudText>

    <!-- Kontainer ECharts -->
    <div style="flex-grow: 1; min-height: 0;">
        <EChartWrapper ChartOptionJson="@_chartOptionJson" Height="@(CardHeight - 50)" />
    </div>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public List<ChartSeries<double>> Series { get; set; } = new();
    [Parameter] public string[] XAxisLabels { get; set; } = Array.Empty<string>();
    [Parameter] public string[] Colors { get; set; } = Array.Empty<string>();

    [Parameter] public bool ShowCustomLegend { get; set; } = true;
    [Parameter] public bool ShowMarkers { get; set; } = true;
    [Parameter] public int StrokeWidth { get; set; } = 3;

    [Parameter] public LineDisplayType DisplayType { get; set; } = LineDisplayType.Area;

    [Parameter] public Typo TitleTypo { get; set; } = Typo.h6;
    [Parameter] public int LegendIconSize { get; set; } = 10;
    [Parameter] public int CardHeight { get; set; } = 280;

    private string _chartOptionJson = "{}";

    private readonly string _fontFamily = "Inter, Roboto, Helvetica, Arial, sans-serif";
    private readonly string[] _defaultColors = { "#059669", "#3b82f6", "#f59e0b", "#ef4444", "#8b5cf6" };

    protected override void OnParametersSet()
    {
        if (Series != null && Series.Any())
        {
            var optionObj = GetChartOptions();

            _chartOptionJson = JsonSerializer.Serialize(optionObj, new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
            });
        }
    }

    private object GetChartOptions()
    {
        var chartColors = Colors != null && Colors.Length > 0 ? Colors : _defaultColors;

        var seriesList = new List<object>();
        foreach (var s in Series)
        {
            var seriesObj = new
            {
                name = s.Name,
                type = "line",
                stack = "Total",
                smooth = true,   
                showSymbol = ShowMarkers,
                lineStyle = new { width = StrokeWidth },
                data = s.Data,
            };

            seriesList.Add(seriesObj);
        }

        return new
        {
            tooltip = new
            {
                trigger = "axis",
                axisPointer = new { type = "none" },
                textStyle = new { fontFamily = _fontFamily },
                formatter = "{b} <br/>{a}: <b>{c}%</b>"
            },
            legend = new
            {
                show = ShowCustomLegend,
                icon = "circle",
                top = "0%",
                right = "0%",
                itemWidth = LegendIconSize,
                itemHeight = LegendIconSize,
                textStyle = new
                {
                    fontFamily = _fontFamily,
                    fontSize = 11,
                    color = "var(--mud-palette-text-secondary)"
                }
            },
            grid = new
            {
                left = "1%",
                right = "8%", // 3. Ruang kanan diperlebar agar tanggal terakhir tidak terpotong
                bottom = "0%",
                top = "15%",
                containLabel = true
            },
            color = chartColors,
            xAxis = new
            {
                type = "category",
                boundaryGap = false,
                data = XAxisLabels,
                axisLabel = new
                {
                    fontFamily = _fontFamily,
                    color = "var(--mud-palette-text-secondary)",
                    interval = 4,
                },
                axisLine = new
                {
                    lineStyle = new { color = "var(--mud-palette-lines-default)" }
                }
            },
            yAxis = new
            {
                type = "value",
                max = 100, // 4a. Mengunci batas maksimal Y-Axis di angka 100
                axisLabel = new
                {
                    formatter = "{value} %", // 4b. Menambahkan simbol %
                    fontFamily = _fontFamily,
                    color = "var(--mud-palette-text-secondary)"
                },
                splitLine = new
                {
                    lineStyle = new
                    {
                        color = "var(--mud-palette-lines-default)",
                        type = "dashed"
                    }
                }
            },
            series = seriesList.ToArray()
        };
    }
}