@using System.Globalization
@using System.Text.Json

<MudCard Class="pa-2" Style=@($"height: 100%; min-height: {CardHeight}px;")>
    <MudCardContent Class="d-flex flex-column" Style="height: 100%;">
        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@Title</MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Style="flex: 1 1 auto; min-height: 0; flex-wrap: wrap; row-gap: 12px;">
            <div style="position: relative; aspect-ratio: 1 / 1; height: @(_chartHeight)px; flex: 0 0 auto;">
                @if (HasData)
                {
                    <EChartWrapper ChartOptionJson="@_optionJson" Height="@_chartHeight" />
                }
                else
                {
                    <div class="d-flex justify-center align-center" style="width: 100%; height: 100%;">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Default" />
                    </div>
                }
            </div>

            <MudStack Spacing="2" Style="flex: 1 1 160px; min-width: 140px;">
                @for (var i = 0; i < Data.Length; i++)
                {
                    var index = i;
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <div style="width: 10px; height: 10px; border-radius: 50%; background-color: @(index < Colors.Length ? Colors[index] : "#94A3B8"); flex-shrink: 0;"></div>
                        <MudText Typo="Typo.body2">@(index < Labels.Length ? Labels[index] : string.Empty) @((int)Math.Round(Data[index])) (@GetPercentageText(index))</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Slice values, same order as Labels and Colors.</summary>
    [Parameter, EditorRequired]
    public double[] Data { get; set; } = Array.Empty<double>();

    [Parameter, EditorRequired]
    public string[] Labels { get; set; } = Array.Empty<string>();

    /// <summary>Explicit hex colors per slice, same order as Data/Labels.</summary>
    [Parameter, EditorRequired]
    public string[] Colors { get; set; } = Array.Empty<string>();

    /// <summary>Text shown in the center of the donut (e.g. "Total Tiket").</summary>
    [Parameter]
    public string TotalText { get; set; } = string.Empty;

    /// <summary>When true, each slice's tooltip/label shows both percentage and raw count.</summary>
    [Parameter]
    public bool ShowPercentageAndNumber { get; set; }

    [Parameter]
    public int CardHeight { get; set; } = 300;

    /// <summary>
    /// Whether real data has arrived yet. The chart is only mounted once this is
    /// true, so its very first ECharts render always carries final data — this
    /// keeps the entrance animation reliable regardless of when the async report
    /// load resolves relative to the component's first paint.
    /// </summary>
    [Parameter]
    public bool HasData { get; set; } = true;

    private static readonly CultureInfo IdCulture = CultureInfo.GetCultureInfo("id-ID");

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    private string _optionJson = "{}";
    private int _chartHeight;

    protected override void OnParametersSet()
    {
        _chartHeight = Math.Clamp(CardHeight - 160, 110, 150);
        _optionJson = BuildDonutOption();
    }

    private string GetPercentageText(int index)
    {
        var total = Data.Sum();

        if (total <= 0)
        {
            return "0,0%";
        }

        var percentage = Data[index] * 100 / total;

        return percentage.ToString("0.0", IdCulture) + "%";
    }

    private string BuildDonutOption()
    {
        var total = Data.Sum();

        var slices = Data
            .Select((value, index) => new
            {
                value = Math.Round(value, 1),
                name = index < Labels.Length ? Labels[index] : string.Empty,
                itemStyle = new
                {
                    color = index < Colors.Length ? Colors[index] : "#94A3B8"
                }
            })
            .ToArray();

        var tooltipFormatter = ShowPercentageAndNumber
            ? "{b}: {c} ({d}%)"
            : "{b}: {d}%";

        var option = new
        {
            animation = true,
            animationDuration = 800,
            animationEasing = "cubicOut",
            animationDurationUpdate = 800,
            animationEasingUpdate = "cubicOut",
            tooltip = new
            {
                trigger = "item",
                formatter = tooltipFormatter
            },
            legend = new
            {
                show = false
            },
            series = new object[]
            {
                new
                {
                    type = "pie",
                    radius = new[] { "70%", "90%" },
                    avoidLabelOverlap = true,
                    itemStyle = new
                    {
                        borderRadius = 5,
                        borderColor = "#fff",
                        borderWidth = 2
                    },
                    label = new { show = false },
                    labelLine = new { show = false },
                    emphasis = new
                    {
                        scale = true,
                        scaleSize = 6
                    },
                    data = slices
                }
            },
            graphic = new object[]
            {
                new
                {
                    type = "text",
                    left = "center",
                    top = "44%",
                    style = new
                    {
                        text = total.ToString("N0"),
                        fontSize = 22,
                        fontWeight = "bold",
                        fill = "#1e293b"
                    }
                },
                new
                {
                    type = "text",
                    left = "center",
                    top = "56%",
                    style = new
                    {
                        text = TotalText,
                        fontSize = 12,
                        fill = "#64748b"
                    }
                }
            }
        };

        return JsonSerializer.Serialize(option, JsonOptions);
    }
}
