@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using SupportTicketSystem.Shared.DTOs.Dashboard
@* Adjust the namespace below to match your exact project structure *@
@using SupportTicketSystem.Client.Features.Interfaces

@* 1. Protect this route at the framework level *@
@attribute [Authorize(Roles = "Manager")]

@inject IDashboardClient DashboardClient
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    @* Top-level Loading Indicator *@
    <div style="height: 4px;" class="mb-4">
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
    </div>

    @* Header Section *@
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary"><b>Dashboard</b></MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Welcome back, @_managerName! Here's your workload overview.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Color="Color.Primary"
                   OnClick="LoadDataAsync"
                   Disabled="@_isLoading">
            Refresh Data
        </MudButton>
    </div>

    @* Metrics Grid *@
    @if (_summary != null)
    {
        <MudGrid>
            @* We use the local RenderFragment defined below to keep the code clean and consistent *@
            @MetricCard("Total Tickets", _summary.TotalTickets, Icons.Material.Filled.ConfirmationNumber, Color.Primary)

            @* Highlighting Unassigned in Error color to draw the Manager's attention *@
            @MetricCard("Unassigned", _summary.UnassignedTickets, Icons.Material.Filled.AssignmentLate, Color.Error)

            @MetricCard("Open", _summary.OpenTickets, Icons.Material.Filled.FiberNew, Color.Info)
            @MetricCard("In Progress", _summary.InProgressTickets, Icons.Material.Filled.PendingActions, Color.Warning)
            @MetricCard("Resolved", _summary.ResolvedTickets, Icons.Material.Filled.TaskAlt, Color.Success)
            @MetricCard("Closed", _summary.ClosedTickets, Icons.Material.Filled.Archive, Color.Default)

            @* Weekly Trends Chart (Optional Bonus based on the provided DTO) *@
            @if (_summary.WeeklyTrends != null && _summary.WeeklyTrends.Any())
            {
                <MudItem xs="12" Class="mt-4">
                    <MudCard Variant="Variant.Outlined">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Ticket Creation Trends (This Week)</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudChart ChartType="ChartType.Bar"
                                      T="double"
                                      ChartSeries="@_chartSeries"
                                      XAxisLabels="@_xAxisLabels"
                                      Width="100%"
                                      Height="350px" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private DashboardSummaryDto? _summary;

    // In a real application, you would inject AuthenticationStateProvider here
    // to dynamically extract the user's name from their ClaimsPrincipal.
    private string _managerName = "Manager";

    // Chart Data properties (Updated to use generic type <double>)
    private List<ChartSeries<double>> _chartSeries = new();
    private string[] _xAxisLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged(); // Force the progress bar to render immediately

        try
        {
            var response = await DashboardClient.GetSummaryAsync();

            // Based on your DashboardClient.cs implementation (Success and Data properties)
            if (response != null && response.Success && response.Data != null)
            {
                _summary = response.Data;
                PrepareChartData();
            }
            else
            {
                Snackbar.Add("Failed to load dashboard data from the server.", MudBlazor.Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred while fetching dashboard data: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PrepareChartData()
    {
        if (_summary?.WeeklyTrends != null)
        {
            _xAxisLabels = _summary.WeeklyTrends.Select(t => t.DayName).ToArray();
            _chartSeries = new List<ChartSeries<double>>
            {
                new ChartSeries<double>
                {
                    Name = "Tickets Created",
                    Data = _summary.WeeklyTrends.Select(t => (double)t.Count).ToArray()
                }
            };
        }
    }

    // --- LOCAL RENDER FRAGMENT ---
    // This allows us to reuse the exact same Card HTML/MudBlazor layout for every metric,
    // reducing UI bugs and maintaining strict visual uniformity.
    private RenderFragment MetricCard(string title, int value, string icon, Color iconColor) => __builder =>
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Variant="Variant.Outlined" Class="pa-2">
                <MudCardContent Class="d-flex align-center">
                    <MudAvatar Color="@iconColor" Variant="Variant.Filled" Size="Size.Large" Class="mr-4">
                        <MudIcon Icon="@icon" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@title</MudText>
                        <MudText Typo="Typo.h4"><b>@value</b></MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    };
}