@page "/dashboard"
@* @attribute [Authorize(Roles = "Manager")] *@

@using SupportTicketSystem.Shared.DTOs.Dashboard
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IDashboardClient DashboardClient
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    @* Indikator Loading di bagian atas *@
    <div style="height: 4px;" class="mb-4">
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
    </div>

    @* Bagian Header *@
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary"><b>Dashboard</b></MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Selamat datang kembali, @_managerName! Berikut adalah ringkasan sistem saat ini.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Color="Color.Primary"
                   OnClick="LoadDataAsync"
                   Disabled="@_isLoading">
            Refresh Data
        </MudButton>
    </div>

    @* Grid Metrik Utama *@
    @if (_summary != null)
    {
        <MudGrid>
            @MetricCard("Total Tiket", _summary.TotalTickets, Icons.Material.Filled.ConfirmationNumber, Color.Primary)
            @MetricCard("Tiket Open", _summary.OpenTickets, Icons.Material.Filled.Warning, Color.Warning)
            @MetricCard("Tiket In Progress", _summary.InProgressTickets, Icons.Material.Filled.Autorenew, Color.Info)
            @MetricCard("Tiket Resolved", _summary.ResolvedTickets, Icons.Material.Filled.CheckCircle, Color.Success)
            @MetricCard("Tiket Closed", _summary.ClosedTickets, Icons.Material.Filled.TaskAlt, Color.Dark)
            @MetricCard("Belum Ditugaskan", _summary.UnassignedTickets, Icons.Material.Filled.PersonOff, Color.Error)
        </MudGrid>

        @* Bagian Grafik Trend Mingguan *@
        <MudGrid Class="mt-4">
            <MudItem xs="12">
                <MudCard Elevation="3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Tren Pembuatan Tiket (7 Hari Terakhir)</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <style>
                            .ticket-trend-chart .mud-charts-xaxis text,
                            .ticket-trend-chart .mud-charts-yaxis text,
                            .ticket-trend-chart text {
                                fill: var(--mud-palette-text-primary) !important;
                                font-size: 0.85rem;
                            }
                        </style>
                        <div class="ticket-trend-chart">
                        @if (_chartSeries.Any() && _xAxisLabels.Any())
                        {
                            <MudChart T="double"
                                      ChartType="ChartType.Bar"
                                      ChartSeries="@_chartSeries"
                                      ChartLabels="@_xAxisLabels"
                                      ChartOptions="@_chartOptions"
                                      Width="100%"
                                      Height="350px" />
                        }
                        else
                        {
                            <MudAlert Severity="MudBlazor.Severity.Info">Tidak ada data tren untuk ditampilkan.</MudAlert>
                        }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else if (!_isLoading)
    {
        <MudAlert Severity="MudBlazor.Severity.Error" Class="mt-4">Gagal memuat ringkasan dashboard. Silakan coba refresh kembali.</MudAlert>
    }

</MudContainer>

@code {
    private bool _isLoading = true;
    private DashboardSummaryDto? _summary;
    private string _managerName = "Manager";

    private string[] _xAxisLabels = Array.Empty<string>();
    private List<ChartSeries<double>> _chartSeries = new();

    private BarChartOptions _chartOptions = new()
    {
        YAxisTicks = 1,
        YAxisFormat = "0",
        ShowLegend = false,
        ShowToolTips = true,
        XAxisTitle = "Hari (7 hari terakhir)",
        YAxisTitle = "Jumlah Tiket Dibuat",
        ChartPalette = new[] { "#594AE2" } // warna utama sesuai tema Primary
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                _managerName = user.Identity.Name ?? user.FindFirst(ClaimTypes.GivenName)?.Value ?? "Manager";
            }

            var apiResponse = await DashboardClient.GetSummaryAsync();

            if (apiResponse.Success)
            {
                _summary = apiResponse.Data;

                if (_summary == null)
                {
                    Snackbar.Add("Data ringkasan dashboard kosong.", MudBlazor.Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add($"Gagal mengambil data Dashboard: {apiResponse.Message}", MudBlazor.Severity.Error);
            }

            PrepareChartData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal mengambil data Dashboard: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void PrepareChartData()
    {
        if (_summary?.WeeklyTrends != null && _summary.WeeklyTrends.Any())
        {
            _xAxisLabels = _summary.WeeklyTrends.Select(t => t.DayName).ToArray();

            _chartSeries = new List<ChartSeries<double>>
            {
                new ChartSeries<double>
                {
                    Name = "Tiket Dibuat",
                    Data = _summary.WeeklyTrends.Select(t => (double)t.Count).ToArray()
                }
            };
        }
        else
        {
            _xAxisLabels = Array.Empty<string>();
            _chartSeries = new List<ChartSeries<double>>();
        }
    }

    private RenderFragment MetricCard(string title, int value, string icon, Color iconColor) => __builder =>
    {
        <MudItem xs="12" sm="4" md="4">
            <MudCard Elevation="3" Class="pa-2 h-100">
                <MudCardContent Class="d-flex align-center h-100">
                    <MudAvatar Color="@iconColor" Variant="Variant.Filled" Size="Size.Large" Class="mr-4">
                        <MudIcon Icon="@icon" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@title</MudText>
                        <MudText Typo="Typo.h4"><b>@value</b></MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    };
}