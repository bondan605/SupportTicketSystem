@page "/support-agent"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SupportTicketSystem.Shared.DTOs.Tickets
@using SupportTicketSystem.Shared.DTOs.Users
@using SupportTicketSystem.Shared.Models
@using SupportTicketSystem.Domain.Enums
@using SupportTicketSystem.Client.Features.Interfaces
@using MudBlazor

@* Protect route sesuai role *@
@* @attribute [Authorize(Roles = "Agent, SupportAgent")] *@

@inject ITicketClient TicketClient
@inject IUserClient UserClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    <div class="mb-6">
        <MudText Typo="Typo.h4" Color="Color.Primary"><b>Support Agent Workspace</b></MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">Manage and process customer support tickets.</MudText>
    </div>

    @* Form Pembuatan Ticket Baru *@
    <MudPaper Class="pa-4 mb-6" Outlined="true" Elevation="0">
        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3"><b>Create New Ticket</b></MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="_newTicketTitle"
                              Label="Ticket Title / Subject"
                              Placeholder="Masukkan judul tiket..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudGrid Spacing="1">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Value="@_currentUserName"
                                      Label="Customer Name (Logged User)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Value="@_currentUserEmail"
                                      Label="Customer Email (Logged User)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                </MudGrid>
            </MudItem>

            <MudItem xs="12">
                <MudTextField T="string"
                              @bind-Value="_newTicketDescription"
                              Label="Ticket Description"
                              Placeholder="Masukkan deskripsi atau detail permasalahan..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-2 mt-2">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Color="Color.Secondary"
                           OnClick="@(() => _table.ReloadServerData())">
                    Refresh Table
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Disabled="@_isSubmitting"
                           OnClick="CreateTicketAsync">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Saving...</MudText>
                    }
                    else
                    {
                        <MudText>Tambah Ticket</MudText>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* Table untuk Support Agent *@
    <MudTable ServerData="ServerReloadAsync"
              @ref="_table"
              Dense="true"
              Hover="true"
              Outlined="true"
              Elevation="0"
              Loading="@_isLoading">

        <HeaderContent>
            <MudTh>Ticket No.</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created At</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Ticket No."><b>@context.TicketNumber</b></MudTd>
            <MudTd DataLabel="Customer">
                <div>@context.CustomerName</div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CustomerEmail</MudText>
            </MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                    @context.Status.ToString()
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Created At">@context.CreatedAt.ToString("MMM dd, yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudTooltip Text="Edit Ticket">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenEditDialogAsync(context))" />
                </MudTooltip>
                <MudTooltip Text="View Details">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenDetailsDialogAsync(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-4">No tickets available.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

</MudContainer>

@code {
    private MudTable<TicketDto> _table = null!;
    private bool _isLoading = false;
    private bool _isSubmitting = false;

    // State Input Form
    private string _newTicketTitle = string.Empty;
    private string _newTicketDescription = string.Empty;

    // State User Logged-in
    private string _currentUserName = "System User";
    private string _currentUserEmail = "user@example.com";

    protected override async Task OnInitializedAsync()
    {
        await LoadLoggedInUserDataAsync();
    }

    /// <summary>
    /// Mengambil Nama & Email dari User yang sedang terautentikasi/login
    /// </summary>
    private async Task LoadLoggedInUserDataAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                _currentUserName = user.FindFirst(ClaimTypes.Name)?.Value
                                   ?? user.Identity.Name
                                   ?? "Unknown Agent";

                _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value
                                    ?? "agent@domain.com";
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat profil pengguna: {ex.Message}", MudBlazor.Severity.Warning);
        }
    }

    private async Task<TableData<TicketDto>> ServerReloadAsync(TableState state, CancellationToken token)
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var request = new PagedRequest
            {
                PageNumber = state.Page + 1,
                PageSize = state.PageSize
            };

            var response = await TicketClient.GetFilteredTicketsAsync(null, null, request);
            IEnumerable<TicketDto> data = response?.Items ?? Array.Empty<TicketDto>();

            return new TableData<TicketDto> { TotalItems = response?.TotalCount ?? 0, Items = data };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading tickets: {ex.Message}", MudBlazor.Severity.Error);
            return new TableData<TicketDto> { TotalItems = 0, Items = Array.Empty<TicketDto>() };
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Mengirimkan DTO ke API Post /api/tickets
    /// </summary>
    private async Task CreateTicketAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTicketTitle))
        {
            Snackbar.Add("Judul tiket wajib diisi.", MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_newTicketDescription))
        {
            Snackbar.Add("Deskripsi tiket wajib diisi.", MudBlazor.Severity.Warning);
            return;
        }

        _isSubmitting = true;

        try
        {
            var createDto = new CreateTicketDto
            {
                Title = _newTicketTitle,
                Description = _newTicketDescription,
                CustomerName = _currentUserName,   // Menggunakan Name dari Claims
                CustomerEmail = _currentUserEmail, // Menggunakan Email dari Claims
                Status = TicketStatus.Open
            };

            var response = await TicketClient.CreateTicketAsync(createDto);

            if (response != null && response.Success)
            {
                Snackbar.Add("Ticket berhasil ditambahkan!", MudBlazor.Severity.Success);

                // Reset Form
                _newTicketTitle = string.Empty;
                _newTicketDescription = string.Empty;

                await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Gagal menambahkan ticket.", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenEditDialogAsync(TicketDto ticket)
    {
        await DialogService.ShowMessageBoxAsync("Edit Action", $"Modal to edit {ticket.TicketNumber} would open here.");
    }

    private async Task OpenDetailsDialogAsync(TicketDto ticket)
    {
        await DialogService.ShowMessageBoxAsync("Details Action", $"Modal to view {ticket.TicketNumber} details would open here.");
    }

    private Color GetStatusColor(TicketStatus status)
    {
        return status switch
        {
            TicketStatus.Open => Color.Info,
            TicketStatus.InProgress => Color.Warning,
            TicketStatus.Resolved => Color.Success,
            TicketStatus.Closed => Color.Dark,
            _ => Color.Default
        };
    }
}