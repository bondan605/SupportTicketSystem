@using SupportTicketSystem.Shared.DTOs.Users
@using MudBlazor

<MudDialog>
    <DialogContent>

        <MudSelect T="Guid?"
                   Label="Assign Agent"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   @bind-Value="_selectedAgentId">

            @foreach (var agent in Agents)
            {
                <MudSelectItem T="Guid?" Value="@agent.Id">
                    @agent.Id
                </MudSelectItem>
            }

        </MudSelect>

    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Save">
            Save
        </MudButton>
    </DialogActions>

</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid TicketId { get; set; }

    [Parameter]
    public List<UserDto> Agents { get; set; } = new();

    private Guid? _selectedAgentId;

    private void Save()
    {
        MudDialog.Close(DialogResult.Ok(_selectedAgentId));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}