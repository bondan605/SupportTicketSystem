@page "/unauthorized"
@layout Layout.AuthLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center mud-width-full" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-6 mud-width-full">
        <MudCardContent Class="d-flex flex-column align-center text-center">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Style="font-size: 4rem;" Class="mb-4" />
            <MudText Typo="Typo.h4" Color="Color.Error" Class="mb-2">
                <b>Access Denied</b>
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                You don't have permission to view this page, or your session has expired.
            </MudText>
        </MudCardContent>

        <MudCardActions Class="d-flex flex-column gap-2 px-4 pb-4">
            <MudButton Href="@AppRoutes.Login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                Go to Login
            </MudButton>
            <MudButton Href="@AppRoutes.Home" Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true">
                Back to Home
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>
