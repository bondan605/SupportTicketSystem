@page "/login"
@layout Layout.AuthLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center mud-width-full" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-6 mud-width-full">
        <MudCardHeader Class="d-flex justify-center pb-0">
            <CardHeaderContent>
                <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-2">
                    <b>Obscura</b> Support
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Sign in to access your workspace
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <form method="post" action="Account/Login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <MudCardContent>
                @if (HasError)
                {
                    <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">Invalid credentials. Please try again.</MudAlert>
                }

                <MudTextField T="string"
                              Label="Email Address"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              UserAttributes="@(new Dictionary<string, object?> { ["name"] = "email", ["required"] = true })" />

                <MudTextField T="string"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              UserAttributes="@(new Dictionary<string, object?> { ["name"] = "password", ["required"] = true })" />
            </MudCardContent>

            <MudCardActions Class="d-flex flex-column px-4 pb-4">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true">
                    Sign In
                </MudButton>
            </MudCardActions>
        </form>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool HasError => Error is not null;
}
