@page "/login"
@layout Layout.AuthLayout

@inject IAuthClient AuthClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center mud-width-full" Style="height: 100vh;">
    <MudCard Elevation="4" Class="pa-6" Width="100%">
        <MudCardHeader Class="d-flex justify-center pb-0">
            <CardHeaderContent>
                <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-2">
                    <b>Obscura</b> Support
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Sign in to access your workspace
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudForm Model="@_model" @ref="_form" Validation="@(_loginValidator.ValidateValue)" ValidationDelay="0">
                <MudTextField @bind-Value="_model.Email"
                              For="@(() => _model.Email)"
                              Label="Email Address"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Email" />

                <MudTextField @bind-Value="_model.Password"
                              For="@(() => _model.Password)"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Lock" />
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="d-flex flex-column px-4 pb-4">
            <MudButton OnClick="HandleLoginAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Authenticating...</MudText>
                }
                else
                {
                    <MudText>Sign In</MudText>
                }
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = null!;
    private readonly LoginRequestDto _model = new();
    private readonly LoginRequestDtoValidator _loginValidator = new();
    private bool _isLoading = false;

    private async Task HandleLoginAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _isLoading = true;

        try
        {
            // --- TEMPORARY MOCK / DUMMY DATA ---
            // Uncomment the line below and remove the mock data when the backend auth is ready
            // var response = await AuthClient.LoginAsync(_model);

            // 1. Simulate network latency for UI testing
            await Task.Delay(1500);

            // 2. Determine dummy role based on email input for testing flexibility
            UserRole dummyRole = _model.Email.Contains("manager", StringComparison.OrdinalIgnoreCase)
                                 ? UserRole.Manager
                                 : (UserRole)2; // Assuming 2 or anything else is Agent/Support

            // 3. Create dummy response
            var response = new LoginResponseDto
            {
                UserId = Guid.NewGuid(),
                Name = "Mock User",
                Email = _model.Email,
                Role = dummyRole,
                Token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_token_payload.signature_12345"
            };
            // --- END OF MOCK DATA ---

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                Snackbar.Add("Login successful (Mock Mode)", MudBlazor.Severity.Success);

                if (response.Role == UserRole.Manager)
                {
                    NavigationManager.NavigateTo("/dashboard");
                }
                else
                {
                    NavigationManager.NavigateTo("/tickets");
                }
            }
            else
            {
                Snackbar.Add("Invalid credentials. Please try again.", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Authentication failed: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class LoginRequestDtoValidator : AbstractValidator<LoginRequestDto>
    {
        public LoginRequestDtoValidator()
        {
            RuleFor(x => x.Email)
                .NotEmpty().WithMessage("Email is required.")
                .EmailAddress().WithMessage("Please enter a valid email format.");

            RuleFor(x => x.Password)
                .NotEmpty().WithMessage("Password is required.");
        }

        public Func<object, string, Task<IEnumerable<string>>> ValidateValue => async (model, propertyName) =>
        {
            var result = await ValidateAsync(ValidationContext<LoginRequestDto>.CreateWithOptions((LoginRequestDto)model, x => x.IncludeProperties(propertyName)));
            if (result.IsValid)
                return Array.Empty<string>();
            return result.Errors.Select(e => e.ErrorMessage);
        };
    }
}