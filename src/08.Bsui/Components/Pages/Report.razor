@page "/report"

@using SupportTicketSystem.Bsui.Components.Shared
@using SupportTicketSystem.Bsui.Components.Models.Reports
@using SupportTicketSystem.Client.Features.Interfaces
@using SupportTicketSystem.Shared.DTOs.Reports.Responses

@inject IReportClient ReportClient
@inject ISnackbar Snackbar

<PageTitle>Reports</PageTitle>

    @* Header *@
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="pa-4 pl-6 pr-6">

        <MudStack Spacing="0">
            <MudText Typo="Typo.h5"
                     Class="font-weight-bold"
                     Style="color:#1e293b;">
                <b>Reports</b>
            </MudText>

            <MudText Typo="Typo.body2"
                     Style="color:#64748b;">
                Laporan dan analisis data tiket
            </MudText>
        </MudStack>

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="4">

            @* <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.CalendarMonth"
                       Color="Color.Default">
                    @DateRangeText
            </MudButton> *@

            @* <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.FileDownload"
                       Color="Color.Default">
                Export
            </MudButton> *@

            @* <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Outlined.FilterAlt"
                       Color="Color.Default">
                Filter
            </MudButton> *@
            <ProfileMenu />
        </MudStack>
    </MudStack>

<MudDivider />

    <MudContainer MaxWidth="MaxWidth.False"
              Class="px-3 pt-3 pb-2">
        @* Summary card *@
        <MudStack Row="true"
                  Spacing="2"
                  Wrap="Wrap.NoWrap"
                  Class="mb-3"
                  Style="width:100%; box-sizing:border-box;">

            <SummaryCard Title="Total Tickets"
                     Value="@_report.Overview.TotalTickets.ToString("N0")"
                         Description="Semua tiket"
                         Icon="@Icons.Material.Filled.ConfirmationNumber"
                         IconBackgroundColor="#1677ff" />

            <SummaryCard Title="Open"
                     Value="@_report.Overview.OpenCount.ToString("N0")"
                     Description="@GetPercentageText(_report.Overview.OpenCount)"
                         Icon="@Icons.Material.Filled.CheckCircleOutline"
                         IconBackgroundColor="#00c853" />

            <SummaryCard Title="In Progress"
                     Value="@_report.Overview.InProgressCount.ToString("N0")"
                     Description="@GetPercentageText(_report.Overview.InProgressCount)"
                         Icon="@Icons.Material.Filled.HourglassEmpty"
                         IconBackgroundColor="#ffb300" />

            <SummaryCard Title="Resolved"
                     Value="@_report.Overview.ResolvedCount.ToString("N0")"
                     Description="@GetPercentageText(_report.Overview.ResolvedCount)"
                         Icon="@Icons.Material.Filled.DoneAll"
                         IconBackgroundColor="#14b8a6" />

            <SummaryCard Title="Closed"
                         Value="@_report.Overview.ClosedCount.ToString("N0")"
                         Description="@GetPercentageText(_report.Overview.ClosedCount)"
                         Icon="@Icons.Material.Filled.MoreHoriz"
                         IconBackgroundColor="#5b5fe9" />

        </MudStack>

        @* Bar chart dan average time *@
    <MudGrid Spacing="3">
    
        <MudItem xs="12" lg="4">
            <DonutChart Title="Tickets per Status"
                        Data="@_statusData"
                        Labels="@_statusLabels"
                        Colors="@_statusColors"
                        TotalText="Total Tiket"
                        ShowPercentageAndNumber="true"
                        CardHeight="280" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <LineChart Title="Ticket Trends"
                       Series="@_ticketTrendSeries"
                       XAxisLabels="@_months"
                       Colors="@_trendColors"
                       CardHeight="280" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <AssigneeBarChart Title="Tickets per Assignee (Top 6)"
                              Items="@_assigneeChartData"
                              AxisMaximum="@AssigneeAxisMaximum"
                              AxisStep="@AssigneeAxisStep"
                              BarColor="#2F73F6"
                              CardHeight="280" />
        </MudItem>

        <MudItem xs="12" lg="3">
            <DonutChart Title="Tickets per Category"
                        Data="@_categoryTicket"
                        Labels="@_categoryLabels"
                        Colors="@_categoryColors"
                        TotalText="Total Tiket"
                        CardHeight="260" />
        </MudItem>

        <MudItem xs="12" lg="3">
            <DonutChart Title="Tickets per Priority"
                        Data="@_priorityData"
                        Labels="@_priorityLabels"
                        Colors="@_priorityColors"
                        TotalText="Total Tiket"
                        CardHeight="260" />
        </MudItem>

        <MudItem xs="12" lg="3">
            <AverageResponseTimeCard Data="@_averageResponseTime"
                                     CardHeight="260" />
        </MudItem>

        <MudItem xs="12" lg="3">
            <SLAComplianceCard Title="SLA Compliance"
                               Value="@SlaCompliance"
                               Subtitle="Kepatuhan SLA"
                               TrendValue="@SlaTrendValue"
                               CardHeight="260" />
        </MudItem>
     
        <MudItem xs="12" lg="4">
            <TicketsByCategoryTable Title="Tickets by Category"
                                    Items="@_categoryData"
                                    TotalTickets="@_report.Overview.TotalTickets"
                                    CardHeight="280"
                                    BarColor="#2F73F6" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <RecentClosedTickets Items="@ClosedTickets"
                                 CardHeight="280" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <LineChart Title="SLA Compliance Trend"
                       Series="@_slaTrendSeries"
                       XAxisLabels="@_slaMonth"
                       Colors="@_slacolors"
                       ShowCustomLegend="false"
                       CardHeight="280" />
        </MudItem>

    </MudGrid>
    </MudContainer>

@code {
    private DateTime? _startDate = DateTime.Today.AddDays(-30);
    private DateTime? _endDate = DateTime.Today;

    private ReportSummaryDto _report = new();

    private IReadOnlyList<AssigneeChartItem> _assigneeChartData =
        Array.Empty<AssigneeChartItem>();

    private IReadOnlyList<CategoryReportItem> _categoryData =
        Array.Empty<CategoryReportItem>();

    private AverageResponseTimeModel _averageResponseTime =
        new(
            Duration: TimeSpan.Zero,
            ChangePercentage: 0m,
            IsIncrease: false);

    private double[] _statusData = Array.Empty<double>();
    private string[] _statusLabels = Array.Empty<string>();
    private string[] _statusColors = Array.Empty<string>();

    private double[] _categoryTicket = Array.Empty<double>();
    private string[] _categoryLabels = Array.Empty<string>();
    private string[] _categoryColors = Array.Empty<string>();

    private double[] _priorityData = Array.Empty<double>();
    private string[] _priorityLabels = Array.Empty<string>();
    private string[] _priorityColors = Array.Empty<string>();

    private string[] _months = Array.Empty<string>();

    private readonly string[] _trendColors =
    {
        "#3B82F6",
        "#10B981"
    };

    private List<ChartSeries<double>> _ticketTrendSeries = new();

    private string[] _slaMonth = Array.Empty<string>();

    private readonly string[] _slacolors =
    {
        "#10B981"
    };

    private List<ChartSeries<double>> _slaTrendSeries = new();

    private double SlaCompliance;

    private string SlaTrendValue = "-";

    private List<ClosedTicketModel> ClosedTickets = new();

    private string DateRangeText =>
        $"{_startDate?.ToString("dd MMM yyyy") ?? "-"} - " +
        $"{_endDate?.ToString("dd MMM yyyy") ?? "-"}";

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        try
        {
            var response =
                await ReportClient.GetReportSummaryAsync(
                    _startDate,
                    _endDate);

            if (!response.Success || response.Data is null)
            {
                Snackbar.Add(
                    response.Message ?? "Data report gagal diambil.",
                    MudBlazor.Severity.Error);

                return;
            }

            ApplyReport(response.Data);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Gagal mengambil data report: {ex.Message}",
                MudBlazor.Severity.Error);
        }
    }

    private void ApplyReport(ReportSummaryDto report)
    {
        _report = report;

        ApplyStatusData(report);
        ApplyTicketTrendData(report);
        ApplyAssigneeData(report);
        ApplyCategoryData(report);
        ApplyPriorityData(report);
        ApplyAverageResponseTime(report);
        ApplySlaCompliance(report);
        ApplyRecentClosedTickets(report);
        ApplySlaTrend(report);
    }

    private void ApplyStatusData(ReportSummaryDto report)
    {
        var statusItems = report.TicketsPerStatus
            .OrderBy(item => GetStatusOrder(item.Status))
            .ToList();

        _statusData = statusItems
            .Select(item => (double)item.Count)
            .ToArray();

        _statusLabels = statusItems
            .Select(item => GetStatusText(item.Status))
            .ToArray();

        _statusColors = statusItems
            .Select(item => GetStatusColor(item.Status))
            .ToArray();
    }

    private void ApplyTicketTrendData(ReportSummaryDto report)
    {
        var trendItems = report.TicketsTrend
            .OrderBy(item => item.Date)
            .ToList();

        _months = trendItems
            .Select((item, index) =>
                index % 5 == 0
                    ? item.Date.ToString("dd MMM")
                    : string.Empty)
            .ToArray();

        _ticketTrendSeries = new List<ChartSeries<double>>
        {
            new()
            {
                Name = "Created",
                Data = trendItems
                    .Select(item => (double)item.CreatedCount)
                    .ToArray()
            },
            new()
            {
                Name = "Closed",
                Data = trendItems
                    .Select(item => (double)item.ClosedCount)
                    .ToArray()
            }
        };
    }

    private void ApplyAssigneeData(ReportSummaryDto report)
    {
        _assigneeChartData = report.TicketsPerAssignee
            .OrderByDescending(item => item.Count)
            .Take(6)
            .Select(item => new AssigneeChartItem(
                item.AssigneeName,
                item.Count))
            .ToList();
    }

    private void ApplyCategoryData(ReportSummaryDto report)
    {
        var categoryItems = report.TicketsPerCategory
            .OrderByDescending(item => item.Count)
            .ToList();

        _categoryData = categoryItems
            .Select(item => new CategoryReportItem(
                GetCategoryText(item.Category),
                item.Count))
            .ToList();

        _categoryTicket = categoryItems
            .Select(item => (double)item.Count)
            .ToArray();

        _categoryLabels = categoryItems
            .Select(item => GetCategoryText(item.Category))
            .ToArray();

        _categoryColors = categoryItems
            .Select(item => GetCategoryColor(item.Category))
            .ToArray();
    }

    private void ApplyPriorityData(ReportSummaryDto report)
    {
        var priorityItems = report.TicketsPerPriority
            .OrderBy(item => GetPriorityOrder(item.Priority))
            .ToList();

        _priorityData = priorityItems
            .Select(item => (double)item.Count)
            .ToArray();

        _priorityLabels = priorityItems
            .Select(item => item.Priority)
            .ToArray();

        _priorityColors = priorityItems
            .Select(item => GetPriorityColor(item.Priority))
            .ToArray();
    }

    private void ApplyAverageResponseTime(ReportSummaryDto report)
    {
        var averageMinutes = Math.Max(
            0,
            report.AverageResponseTime.AverageResponseMinutes);

        var changePercent =
            report.AverageResponseTime.ChangePercent ?? 0;

        _averageResponseTime =
            new AverageResponseTimeModel(
                Duration: TimeSpan.FromMinutes(
                    Math.Round(averageMinutes)),

                ChangePercentage: Convert.ToDecimal(
                    Math.Abs(changePercent)),

                IsIncrease: changePercent > 0);
    }

    private void ApplySlaCompliance(ReportSummaryDto report)
    {
        SlaCompliance =
            report.SlaCompliance.CompliancePercentage;

        SlaTrendValue =
            report.SlaCompliance.ChangePercent.HasValue
                ? $"{report.SlaCompliance.ChangePercent.Value:+0.0;-0.0;0.0}%"
                : "-";
    }

    private void ApplyRecentClosedTickets(ReportSummaryDto report)
    {
        ClosedTickets = report.RecentClosedTickets
            .Where(item => item.ClosedAt.HasValue)
            .Select(item => new ClosedTicketModel
            {
                TicketNumber = item.TicketNumber,
                Title = item.Title,
                ClosedAt = item.ClosedAt.GetValueOrDefault(),
                ClosedBy = item.ClosedBy
            })
            .ToList();
    }

    private void ApplySlaTrend(ReportSummaryDto report)
    {
        var trendItems = report.SlaComplianceTrend
            .OrderBy(item => item.Date)
            .ToList();

        _slaMonth = trendItems
            .Select((item, index) =>
                index % 5 == 0
                    ? item.Date.ToString("dd MMM")
                    : string.Empty)
            .ToArray();

        _slaTrendSeries = new List<ChartSeries<double>>
        {
            new()
            {
                Name = "SLA",
                Data = trendItems
                    .Select(item => (double)item.CumulativeCompliancePercentage)
                    .ToArray()
            }
        };
    }

    private string GetPercentageText(int count)
    {
        var totalTickets = _report.Overview.TotalTickets;

        if (totalTickets <= 0)
        {
            return "0.0% dari total";
        }

        var percentage =
            count * 100d / totalTickets;

        return $"{percentage:0.0}% dari total";
    }

    private int AssigneeAxisStep
    {
        get
        {
            var maximum = GetMaximumAssigneeCount();

            return maximum switch
            {
                <= 10 => 2,
                <= 50 => 10,
                <= 100 => 20,
                <= 250 => 50,
                _ => 100
            };
        }
    }

    private int AssigneeAxisMaximum
    {
        get
        {
            var maximum = GetMaximumAssigneeCount();
            var step = AssigneeAxisStep;

            if (maximum <= 0)
            {
                return step;
            }

            return (int)Math.Ceiling(
                maximum / (double)step) * step;
        }
    }

    private int GetMaximumAssigneeCount()
    {
        return _assigneeChartData.Count == 0
            ? 0
            : _assigneeChartData.Max(
                item => item.TotalTickets);
    }

    private static int GetStatusOrder(string status)
    {
        return status switch
        {
            "Open" => 1,
            "InProgress" => 2,
            "Resolved" => 3,
            "Closed" => 4,
            _ => 99
        };
    }

    private static string GetStatusText(string status)
    {
        return status switch
        {
            "InProgress" => "In Progress",
            _ => status
        };
    }

    private static string GetStatusColor(string status)
    {
        return status switch
        {
            "Open" => "#3B82F6",
            "InProgress" => "#F59E0B",
            "Resolved" => "#10B981",
            "Closed" => "#64748B",
            _ => "#94A3B8"
        };
    }

    private static string GetCategoryText(string category)
    {
        return category switch
        {
            "Application" => "Aplikasi",
            "Access" => "Akses",
            "Report" => "Laporan",
            "Hardware" => "Hardware",
            "Other" => "Lainnya",
            _ => category
        };
    }

    private static string GetCategoryColor(string category)
    {
        return category switch
        {
            "Application" => "#3B82F6",
            "Access" => "#F59E0B",
            "Report" => "#10B981",
            "Hardware" => "#8B5CF6",
            "Other" => "#EF4444",
            _ => "#94A3B8"
        };
    }

    private static int GetPriorityOrder(string priority)
    {
        return priority switch
        {
            "High" => 1,
            "Medium" => 2,
            "Low" => 3,
            _ => 99
        };
    }

    private static string GetPriorityColor(string priority)
    {
        return priority switch
        {
            "High" => "#EF4444",
            "Medium" => "#F59E0B",
            "Low" => "#10B981",
            _ => "#94A3B8"
        };
    }
}