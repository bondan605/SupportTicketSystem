<MudNavMenu>
    @* <MudNavLink Href="@AppRoutes.Home" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">
        Dashboard
    </MudNavLink> *@

    <MudNavLink Href="@AppRoutes.TicketList" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ConfirmationNumber">
        Ticket List
    </MudNavLink>

    <MudNavLink Href="@AppRoutes.TicketHistories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.History">
        Ticket Histories
    </MudNavLink>

    <AuthorizeView Roles="SuperAdmin">
        <Authorized>
            <MudNavLink Href="@AppRoutes.Users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Person">
                Users
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="SuperAdmin,Manager">
        <Authorized>
            <MudNavLink Href="@AppRoutes.Report" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.BarChart">
                Report
            </MudNavLink>

            <MudNavLink Href="@AppRoutes.ReportV2" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.BarChart" Class="nav-link-with-badge">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                    <span>Report V2</span>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="ma-0 nav-link-badge">New</MudChip>
                </MudStack>
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    @* <MudText Typo="Typo.overline" Class="sidebar-section-label">Settings</MudText> *@

    @* <MudNavLink Href="@AppRoutes.Profile" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Person">
        Profile
    </MudNavLink> *@

    @* <MudNavLink Href="@AppRoutes.Settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Settings">
        Settings
    </MudNavLink> *@

    <MudSpacer />

    <form method="post" action="Account/Logout">
        <AntiforgeryToken />
        <button type="submit" class="mud-nav-link sidebar-logout">
            <MudIcon Icon="@Icons.Material.Outlined.Logout" Class="mud-nav-link-icon mr-2" />
            Logout
        </button>
    </form>
</MudNavMenu>

<style>
    .sidebar-logout {
        background: none;
        border: none;
        width: 100%;
        text-align: left;
        display: flex;
        align-items: center;
        cursor: pointer;
        font: inherit;
    }

    .nav-link-badge {
        height: 18px;
        padding: 0 8px;
        font-size: 10px;
        font-weight: 700;
        line-height: 18px;
    }
</style>