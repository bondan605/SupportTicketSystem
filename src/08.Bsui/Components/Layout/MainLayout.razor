@using MudBlazor
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    @* Sidebar *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Class="sidebar" Variant="DrawerVariant.Responsive">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Class="sidebar-title" Align="Align.Center">
                <MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber"></MudIcon>
                System Ticket
            </MudText>
        </MudDrawerHeader>

        @* Injecting the Navigation Menu component *@
        <NavMenu />
    </MudDrawer>

    @* Floating pill toggle - half-tucked into the sidebar's edge when open, flush against
       the viewport's left edge when the sidebar is hidden. *@
    <MudIconButton Icon="@(_drawerOpen ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)"
                   Class="@($"sidebar-toggle {(_drawerOpen ? "sidebar-toggle--open" : "sidebar-toggle--closed")}")"
                   OnClick="DrawerToggle" />

    @* Main Content *@
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-0 pb-0">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode = false;
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Retrieve user's theme preference from local storage
            var savedMode = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "is_dark_mode");

            if (!string.IsNullOrEmpty(savedMode))
            {
                var isDark = savedMode == "true";
                if (isDark != _isDarkMode)
                {
                    _isDarkMode = isDark;
                    StateHasChanged();
                }
            }
        }
    }
}

<style>
    .mud-layout {
        --mud-appbar-height: 0px;
    }

    .mud-drawer.sidebar {
        background-color: #0f1c3f !important;
    }

    .sidebar .mud-drawer-content {
        display: flex;
        flex-direction: column;
        height: 100vh;
        box-sizing: border-box;
        overflow: hidden;
        padding: 0.5rem 0;
    }

    .sidebar .mud-navmenu {
        display: flex;
        flex-direction: column;
        flex: 1 1 0;
        min-height: 0;
    }

    /* Sidebar header title */
    .sidebar-title {
        color: white !important;
        font-weight: bold;
    }

    /* Nav links */
    .sidebar .mud-nav-link {
        color: rgba(255, 255, 255, 0.7) !important;
        margin: 0.2rem 0.75rem !important;
        border-radius: 6px !important;
    }

    .sidebar .mud-nav-link:hover {
        color: white !important;
        background-color: rgba(255, 255, 255, 0.1) !important;
    }

    .sidebar .mud-nav-link.active {
        color: white !important;
        background-color: #1e3a8a !important;
    }

    .sidebar .mud-nav-link .mud-nav-link-icon {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .sidebar .mud-nav-link.active .mud-nav-link-icon,
    .sidebar .mud-nav-link:hover .mud-nav-link-icon {
        color: white !important;
    }

    /* "SETTINGS" section label */
    .sidebar-section-label {
        display: block;
        color: rgba(255, 255, 255, 0.45) !important;
        letter-spacing: 0.05em;
        padding: 1.5rem 1rem 0.5rem 1rem;
    }

    /* Floating pill toggle for the sidebar */
    .sidebar-toggle {
        position: fixed !important;
        top: 50%;
        z-index: 1300;
        width: 32px !important;
        height: 32px !important;
        padding: 0 !important;
        background-color: #0f1c3f !important;
        color: white !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
        transition: left 225ms cubic-bezier(0.4, 0, 0.2, 1), background-color 150ms ease;
    }

    .sidebar-toggle:hover {
        background-color: #1e3a8a !important;
    }

    /* Open: half-tucked into the sidebar, straddling its right edge */
    .sidebar-toggle--open {
        left: var(--mud-drawer-width-left, 250px);
        transform: translate(-50%, -50%);
    }

    /* Hidden: flush against the viewport's left edge */
    .sidebar-toggle--closed {
        left: 0;
        transform: translateY(-50%);
    }
</style>