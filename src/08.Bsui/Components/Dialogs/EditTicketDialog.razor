@using SupportTicketSystem.Domain.Enums
@using MudBlazor

<MudDialog>

    <DialogContent>

        <MudSelect T="TicketStatus"
                   Label="Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   @bind-Value="_selectedStatus">

            @foreach (var status in _statusOptions)
            {
                <MudSelectItem T="TicketStatus" Value="@status">
                    @status
                </MudSelectItem>
            }

        </MudSelect>

    </DialogContent>

    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Save">
            Save
        </MudButton>

    </DialogActions>

</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;


    [Parameter]
    public Guid TicketId { get; set; }

    [Parameter]
    public TicketStatus CurrentStatus { get; set; }

    /// <summary>
    /// Opsi status yang boleh dipilih di dropdown. Jika tidak diberikan (null),
    /// semua status akan ditampilkan.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TicketStatus>? AllowedStatuses { get; set; }

    private TicketStatus _selectedStatus;
    private IReadOnlyList<TicketStatus> _statusOptions = Array.Empty<TicketStatus>();

    protected override void OnInitialized()
    {
        _selectedStatus = CurrentStatus;
        _statusOptions = AllowedStatuses is { Count: > 0 }
            ? AllowedStatuses
            : Enum.GetValues<TicketStatus>();
    }

    private void Save()
    {
        MudDialog.Close(DialogResult.Ok(_selectedStatus));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}