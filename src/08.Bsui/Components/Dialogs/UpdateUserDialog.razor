@using SupportTicketSystem.Shared.DTOs.Users
@using SupportTicketSystem.Domain.Enums
@using SupportTicketSystem.Client.Features.Interfaces
@inject IUserClient UserClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between px-2 pt-2">
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Edit Pengguna</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_updateUserModel" OnValidSubmit="HandleUpdateUser">
            <DataAnnotationsValidator />
            
            <!-- Menggunakan MudGrid dengan Spacing="3" agar rapi dan tidak bertumpuk -->
            <MudGrid Spacing="3" Class="pa-2">
                
                <!-- Nama Lengkap (Full Width) -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_updateUserModel.Name"
                                  Label="Nama Lengkap"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Role & Status (Dibagi 2 kolom) -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="UserRole"
                               @bind-Value="_updateUserModel.Role"
                               Label="Role"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem Value="UserRole.SupportAgent">Support Agent</MudSelectItem>
                        <MudSelectItem Value="UserRole.Manager">Manager</MudSelectItem>
                        <MudSelectItem Value="UserRole.SuperAdmin">Super Admin</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center pt-3">
                    <MudSwitch T="bool"
                               @bind-Value="_updateUserModel.Status"
                               Color="Color.Success"
                               Label="@(_updateUserModel.Status ? "Status: Aktif" : "Status: Non-Aktif")" />
                </MudItem>

                <!-- No. Telepon & Jabatan (Dibagi 2 kolom) -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_updateUserModel.PhoneNumber"
                                  Label="No. Telepon"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_updateUserModel.JobTitle"
                                  Label="Jabatan"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Tanggal Lahir (Full Width) -->
                <MudItem xs="12">
                    <MudDatePicker @bind-Date="_updateUserModel.BirthDate"
                                   Label="Tanggal Lahir"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <!-- Alamat (Full Width dengan Multi-line) -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_updateUserModel.Address"
                                  Label="Alamat"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Margin="Margin.Dense" />
                </MudItem>

            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <div class="px-3 pb-2 d-flex gap-2">
            <MudButton OnClick="Cancel"
                       Variant="Variant.Outlined"
                       Class="px-4">
                Batal
            </MudButton>
            <MudButton Color="Color.Info"
                       Variant="Variant.Filled"
                       OnClick="HandleUpdateUser"
                       Disabled="_isSubmitting"
                       Class="px-4">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Menyimpan...</span>
                }
                else
                {
                    <span>Update Pengguna</span>
                }
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid UserId { get; set; }
    [Parameter] public UpdateUserRequest InitialModel { get; set; } = new();

    private bool _isSubmitting = false;
    private UpdateUserRequest _updateUserModel = new();

    protected override void OnInitialized()
    {
        if (InitialModel != null)
        {
            _updateUserModel = new UpdateUserRequest
            {
                Name = InitialModel.Name,
                Role = InitialModel.Role,
                PhoneNumber = InitialModel.PhoneNumber,
                BirthDate = InitialModel.BirthDate,
                JobTitle = InitialModel.JobTitle,
                Address = InitialModel.Address,
                Status = InitialModel.Status
            };
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task HandleUpdateUser()
    {
        _isSubmitting = true;
        try
        {
            var response = await UserClient.UpdateUserAsync(UserId, _updateUserModel);
            if (response?.Success == true)
            {
                Snackbar.Add("Pengguna berhasil diperbarui!", MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Gagal memperbarui pengguna.", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}