@using SupportTicketSystem.Shared.DTOs.Users
@using SupportTicketSystem.Domain.Enums
@using SupportTicketSystem.Client.Features.Interfaces
@inject IUserClient UserClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between px-2 pt-2">
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Edit Pengguna</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_updateUserModel" OnValidSubmit="HandleUpdateUser">
            <DataAnnotationsValidator />
            
            <MudGrid Spacing="3" Class="pa-2">
                
                <!-- Nama Lengkap -->
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Nama Lengkap <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudTextField @bind-Value="_updateUserModel.Name"
                                  For="@(() => _updateUserModel.Name)"
                                  Placeholder="Masukkan nama lengkap"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Role -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Role (Peran) <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudSelect T="UserRole"
                               @bind-Value="_updateUserModel.Role"
                               For="@(() => _updateUserModel.Role)"
                               Placeholder="Pilih role"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem Value="UserRole.SupportAgent">Support Agent</MudSelectItem>
                        <MudSelectItem Value="UserRole.Manager">Manager</MudSelectItem>
                        <MudSelectItem Value="UserRole.SuperAdmin">Super Admin</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Status -->
                <MudItem xs="12" sm="6" Class="d-flex align-center pt-5">
                    <MudSwitch T="bool"
                               @bind-Value="_updateUserModel.Status"
                               Color="Color.Success"
                               Label="@(_updateUserModel.Status ? "Status: Aktif" : "Status: Non-Aktif")" />
                </MudItem>

                <!-- No. Telepon -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        No. Telepon
                    </MudText>
                    <MudTextField @bind-Value="_updateUserModel.PhoneNumber"
                                  For="@(() => _updateUserModel.PhoneNumber)"
                                  Placeholder="Masukkan nomor telepon"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Jabatan -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Jabatan
                    </MudText>
                    <MudTextField @bind-Value="_updateUserModel.JobTitle"
                                  For="@(() => _updateUserModel.JobTitle)"
                                  Placeholder="Masukkan jabatan"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Tanggal Lahir -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Tanggal Lahir
                    </MudText>
                    <MudDatePicker @bind-Date="_updateUserModel.BirthDate"
                                   For="@(() => _updateUserModel.BirthDate)"
                                   Placeholder="Pilih tanggal lahir"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <!-- Alamat -->
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Alamat
                    </MudText>
                    <MudTextField @bind-Value="_updateUserModel.Address"
                                  For="@(() => _updateUserModel.Address)"
                                  Placeholder="Masukkan alamat lengkap"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Margin="Margin.Dense" />
                </MudItem>

            </MudGrid>

            <div class="px-5 pb-4 pt-2 d-flex justify-end gap-2">
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Class="px-4">Batal</MudButton>
                <MudButton Color="Color.Info" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Disabled="_isSubmitting" Class="px-4">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Menyimpan...</span>
                    }
                    else
                    {
                        <span>Update Pengguna</span>
                    }
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid UserId { get; set; }
    [Parameter] public UpdateUserRequest InitialModel { get; set; } = new();

    private bool _isSubmitting = false;
    private UpdateUserRequest _updateUserModel = new();

    protected override void OnInitialized()
    {
        if (InitialModel != null)
        {
            _updateUserModel = new UpdateUserRequest
            {
                Name = InitialModel.Name,
                Role = InitialModel.Role,
                PhoneNumber = InitialModel.PhoneNumber,
                BirthDate = InitialModel.BirthDate,
                JobTitle = InitialModel.JobTitle,
                Address = InitialModel.Address,
                Status = InitialModel.Status
            };
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task HandleUpdateUser()
    {
        _isSubmitting = true;
        try
        {
            var response = await UserClient.UpdateUserAsync(UserId, _updateUserModel);
            if (response?.Success == true)
            {
                Snackbar.Add("Pengguna berhasil diperbarui!", MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Gagal memperbarui pengguna.", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}