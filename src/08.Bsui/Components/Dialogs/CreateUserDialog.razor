@using SupportTicketSystem.Shared.DTOs.Users
@using SupportTicketSystem.Domain.Enums
@using SupportTicketSystem.Client.Features.Interfaces
@using Blazored.FluentValidation
@inject IUserClient UserClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between px-2 pt-2">
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Tambah Pengguna Baru</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_createUserModel" OnValidSubmit="HandleCreateUser">

            <FluentValidationValidator />

            <MudGrid Spacing="3" Class="pa-2">

                <!-- Nama Lengkap -->
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Nama Lengkap <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.Name"
                                  For="@(() => _createUserModel.Name)"
                                  Placeholder="Masukkan nama lengkap"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Username -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Username <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.Username"
                                  For="@(() => _createUserModel.Username)"
                                  Placeholder="Masukkan username"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Email -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Email <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.Email"
                                  For="@(() => _createUserModel.Email)"
                                  Placeholder="Masukkan alamat email"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Password -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Password <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.Password"
                                  For="@(() => _createUserModel.Password)"
                                  Placeholder="Masukkan password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Konfirmasi Password -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Konfirmasi Password <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.ConfirmPassword"
                                  For="@(() => _createUserModel.ConfirmPassword)"
                                  Placeholder="Ketik ulang password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Role -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Role (Peran) <span style="color: var(--mud-palette-error);">*</span>
                    </MudText>
                    <MudSelect T="UserRole"
                               @bind-Value="_createUserModel.Role"
                               For="@(() => _createUserModel.Role)"
                               Placeholder="Pilih role"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem Value="UserRole.SupportAgent">Support Agent</MudSelectItem>
                        <MudSelectItem Value="UserRole.Manager">Manager</MudSelectItem>
                        <MudSelectItem Value="UserRole.SuperAdmin">Super Admin</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- No. Telepon -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        No. Telepon
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.PhoneNumber"
                                  For="@(() => _createUserModel.PhoneNumber)"
                                  Placeholder="Masukkan nomor telepon"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Jabatan -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Jabatan
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.JobTitle"
                                  For="@(() => _createUserModel.JobTitle)"
                                  Placeholder="Masukkan jabatan"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Tanggal Lahir -->
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Tanggal Lahir
                    </MudText>
                    <MudDatePicker @bind-Date="_createUserModel.BirthDate"
                                   For="@(() => _createUserModel.BirthDate)"
                                   Placeholder="Pilih tanggal lahir"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <!-- Alamat -->
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">
                        Alamat
                    </MudText>
                    <MudTextField @bind-Value="_createUserModel.Address"
                                  For="@(() => _createUserModel.Address)"
                                  Placeholder="Masukkan alamat lengkap"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  Margin="Margin.Dense" />
                </MudItem>

            </MudGrid>

            <div class="px-5 pb-4 pt-2 d-flex justify-end gap-2">
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Class="px-4">Batal</MudButton>
                <!-- Warna disesuaikan dengan tema Sopodel -->
                <MudButton Color="Color.Info" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Disabled="_isSubmitting" Class="px-4">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Menyimpan...</span>
                    }
                    else
                    {
                        <span>Simpan Pengguna</span>
                    }
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _isSubmitting = false;
    private CreateUserRequest _createUserModel = new() { Role = UserRole.SupportAgent };

    private void Cancel() => MudDialog.Cancel();

    private async Task HandleCreateUser()
    {
        _isSubmitting = true;
        try
        {
            var response = await UserClient.CreateUserAsync(_createUserModel);
            if (response?.Success == true)
            {
                Snackbar.Add("Pengguna berhasil ditambahkan!", MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Gagal menambahkan pengguna.", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}